# ========================================================
# Gemini 3.8 Flash Studio - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials
# DO NOT COMMIT '.env' TO GITHUB!
# ========================================================

# Google Gemini API Key (Required)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Cloud & Firebase Authentication (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_ACCOUNT=your-email@example.com
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY_HERE
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE

# Server Port (Default: 3000)
PORT=3000
